property_value: schema:alternateName "Algonquians" xsd:string
property_value: terms:replaces "Algonquian Indian" xsd:string {schema:alternateName="Algonquian Indians"}
property_value: wiki:Q1823134 "http://id.loc.gov/authorities/subjects/sh85003482" xsd:anyURI

[Term]
id: GSSO:005502
name: Arapaho
def: "A tribe of Native Americans historically living on the plains of Colorado and Wyoming. They were close allies of the Cheyenne tribe and loosely aligned with the Lakota and Dakota." []
xref: https://en.wikipedia.org/wiki/Arapaho
xref: https://en.wikipedia.org/wiki/Category\:Arapaho
