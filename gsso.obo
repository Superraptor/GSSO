property_value: schema:alternateName "psychodynamic complexes" xsd:string

[Term]
id: GSSO:004423
name: castration anxiety complex
def: "The fear of emasculation in both the literal and metaphorical sense. Castration anxiety is an overwhelming fear of damage to, or loss of, the penis—one of Sigmund Freud's earliest psychoanalytic theories." []
is_a: GSSO:004422 ! psychodynamic complex
property_value: Property:P1813 "castration complex" xsd:string
