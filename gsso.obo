property_value: wiki:Q1823134 "http://id.loc.gov/authorities/subjects/sh85132273" xsd:anyURI

[Term]
id: GSSO:012916
name: Argentine tango dance
def: "A social dance originating at the end of the 19th century in the suburbs of Buenos Aires and Montevideo. It has continued to grow in popularity and spread internationally, adding modern elements without replacing the older ones. Among its leading figures are the singer and songwriter Carlos Gardel and composers/performers Francisco Canaro, Juan D'Arienzo, Carlos Di Sarli, Osvaldo Pugliese, and Ástor Piazzolla." []
xref: https://en.wikipedia.org/wiki/Argentine_tango#Dance
is_a: GSSO:012915 ! tango dance
property_value: oboInOwl:hasSynonym "Argentine tango" xsd:string

