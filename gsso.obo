[Term]
id: GSSO:000323
name: descriptive linguistics
def: "The work of objectively analyzing and describing how language is actually used (or how it was used in the past) by a group of people in a speech community." []
xref: https://en.wikipedia.org/wiki/Linguistic_description
is_a: http://purl.bioontology.org/ontology/MESH/D008037 ! linguistics
property_value: oboInOwl:hasSynonym "linguistic description" xsd:string {Property:P1813="description"}

[Term]
id: GSSO:000324
name: theoretical linguistics
def: "The branch of linguistics which inquires into the nature of language itself and seeks to answer fundamental questions as to what language is; how it works; how universal grammar (UG) as a domain-specific mental organ operates, if it exists at all; what are its unique properties; how does language relate to other cognitive processes, etc." []
xref: https://en.wikipedia.org/wiki/Theoretical_linguistics
xref: https://www.wikidata.org/wiki/Q351625
is_a: http://purl.bioontology.org/ontology/MESH/D008037 ! linguistics
property_value: oboInOwl:hasSynonym "general linguistics" xsd:string

