[Term]
id: GSSO:008210
name: Mainline Protestantism
def: "An informal grouping of Protestant denominations that contrast in history and practice with evangelical, fundamentalist, and charismatic Protestant denominations. Mainline Protestants were a majority of Protestants in the United States until the mid-20th century. A dip in membership across all Christian denominations was more pronounced among mainline groups, with the result that mainline groups no longer comprise the majority." []
synonym: "mainstream Protestant churches" RELATED []
synonym: "oldline Protestant churches" RELATED []
synonym: "Traditional Protestantism" RELATED []
xref: https://en.wikipedia.org/wiki/Mainline_Protestant
xref: https://www.wikidata.org/wiki/Q1121095
is_a: GSSO:007370 ! Protestantism
property_value: oboInOwl:hasSynonym "mainline Protestant churches" xsd:string

[Term]
id: GSSO:008211
name: Liberal Protestantism
def: "Traditions of Protestantism which developed in the 19th century out of a need to adapt Christianity to a modern intellectual context. With the acceptance of Charles Darwin's theory of natural selection, some traditional Christian beliefs, such as parts of the Genesis creation narrative, became difficult to defend. Unable to ground faith exclusively in an appeal to scripture or the person of Jesus Christ, liberals, according to theologian and intellectual historian Alister McGrath, \"sought to anchor that faith in common human experience, and interpret it in ways that made sense within the modern worldview.\" Beginning in Germany, liberal theology was influenced by several strands of thought, including the Enlightenment's high view of human reason and Pietism's emphasis on religious experience and interdenominational tolerance." []
synonym: "liberal protestantism" EXACT []
xref: https://en.wikipedia.org/wiki/Liberal_Christianity#Liberal_Protestantism
is_a: GSSO:007370 ! Protestantism
property_value: oboInOwl:hasSynonym "liberal protestant religion" xsd:string {schema:alternateName="liberal protestant religions", Property:P5806="http://purl.bioontology.org/ontology/SNOMEDCT/298022006"}

