[Term]
id: GSSO:002809
name: institutional racism
def: "A form of racism expressed in the practice of social and political institutions. It is reflected in disparities regarding wealth, income, criminal justice, employment, housing, health care, political power and education, among other factors." []
synonym: "societal racism" RELATED [] {def="The formalization of a set of institutional, historical, cultural, and interpersonal practices within a society that places one or more social or ethnic groups in a better position to succeed and disadvantages other groups so that disparities develop between the groups over a period of time."}
synonym: "structural racism" RELATED [https://en.wikipedia.org/wiki/Societal_racism, https://www.wikidata.org/wiki/Q17143139]
xref: https://en.wikipedia.org/wiki/Institutional_racism
