is_a: GSSO:004422 ! psychodynamic complex
property_value: Property:P1813 "Lolicon" xsd:string

[Term]
id: GSSO:004431
name: Madonna–whore complex
def: "The inability to maintain sexual arousal within a committed, loving relationship. Said to develop in men who see women as either saintly Madonnas or debased prostitutes. Men with this complex desire a sexual partner who has been degraded (the whore) while they cannot desire the respected partner (the Madonna)." []
synonym: "good girl-bad girl dichotomy" RELATED []
synonym: "Madonna syndrome" RELATED [] {EXACT="madonna syndrome"}
synonym: "Madonna vs. harlot" RELATED []
synonym: "Madonna-whore complex" EXACT []
synonym: "Madonna-whore dichotomy" RELATED [] {Property:P1813="MWD"}
synonym: "Madonna-whore syndrome" RELATED []
synonym: "Madonna/whore complex" EXACT []
synonym: "obscenity-purity complex" RELATED []
synonym: "pedestal/gutter syndrome" RELATED []
synonym: "prostitute-versus-Madonna syndrome" RELATED []
synonym: "virgin-Madonna-whore complex" RELATED [] {EXACT="virgin-madonna-whore complex"}
synonym: "virgin-prostitute syndrome" RELATED []
synonym: "virgin/whore complex" RELATED []
xref: https://en.wikipedia.org/wiki/Madonna%E2%80%93whore_complex
is_a: GSSO:004422 ! psychodynamic complex
property_value: Property:P5191 GSSO:003926
property_value: terms:isReferencedBy https://books.google.com/books/?id=ymkYAAAAIAAJ

[Term]
id: GSSO:004432
name: martyr complex
def: "A desire of the feeling of being a martyr for one's own sake, seeking out suffering or persecution because it either feeds a psychological need or a desire to avoid responsibility." []
synonym: "victim complex" RELATED []
xref: https://en.wikipedia.org/wiki/Martyr_complex
is_a: GSSO:004422 ! psychodynamic complex

[Term]
id: GSSO:004433
name: Phaedra complex
def: "Primarily the sexual desire of a stepmother for her stepson, though the term has been extended to cover difficult relationships between stepparents and stepchildren in general." []
xref: https://en.wikipedia.org/wiki/Phaedra_complex
is_a: GSSO:004422 ! psychodynamic complex

[Term]
id: GSSO:004434
name: Napoleon complex
def: "A theorized inferiority complex normally attributed to people of short stature. It is characterized by overly-aggressive or domineering social behavior, such as lying about earnings, and carries the implication that such behavior is compensatory for the subject's physical or social shortcomings." []
xref: https://en.wikipedia.org/wiki/Napoleon_complex
is_a: GSSO:004422 ! psychodynamic complex

[Term]
id: GSSO:004435
name: Polycrates complex
def: "A desire to be punished, often employed by psychoanalyst criminologists to explain crime." []
xref: https://en.wikipedia.org/wiki/Polycrates_complex
is_a: GSSO:004422 ! psychodynamic complex

[Term]
id: GSSO:004436
name: culture-bound syndrome
def: "A combination of psychiatric and somatic symptoms that are considered to be a recognizable disease only within a specific society or culture. There are no objective biochemical or structural alterations of body organs or functions, and the disease is not recognized in other cultures." []
def: "A pathological behavior pattern that is specific to a particular geographic, ethnic, or cultural group." []
synonym: "culture-specific syndrome" RELATED []
synonym: "folk illness" RELATED []
xref: https://en.wikipedia.org/wiki/Category\:Culture-bound_syndromes
xref: https://en.wikipedia.org/wiki/Culture-bound_syndrome
