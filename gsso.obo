[Term]
id: GAZ:00000468
name: Oceania
def: "A grouping term including Australia, New Zealand, the southwestern islands of the Pacific Ocean and the eastern islands of the Australasian Mediterranean Sea." []
def: "A term used to refer to Polynesia (including New Zealand), Melanesia (including New Guinea), Micronesia as a whole, and Australia." []
def: "The islands of the central and South Pacific, including Micronesia, Melanesia, Polynesia, and traditionally Australasia." []
synonym: "Asia and Oceania" BROAD [] {terms:isReferencedBy="https://books.google.com/books/?id=lnFYAAAAYAAJ"}
