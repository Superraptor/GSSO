property_value: schema:alternateName "grammatical classes" xsd:string

[Term]
id: GSSO:002413
name: syntactic class
def: "A type of syntactic unit that theories of syntax assume. Word classes, largely corresponding to traditional parts of speech (e.g. noun, verb, preposition, etc.), are syntactic categories." []
synonym: "syntactic category" RELATED []
xref: https://en.wikipedia.org/wiki/Syntactic_category
is_a: GSSO:002411 ! linguistic class
property_value: schema:alternateName "syntactic classes" xsd:string

[Term]
id: GSSO:002414
name: grammatical gender
def: "A specific form of noun class system in which the division of noun classes forms an agreement system with another aspect of the language, such as adjectives, articles, pronouns, or verbs. This system is used in approximately one quarter of the world's languages. In these languages, most or all nouns inherently carry one value of the grammatical category called gender; the values present in a given language (of which there are usually two or three) are called the genders of that language." []
synonym: "linguistic gender" RELATED []
synonym: "noun class" RELATED []
xref: https://en.wikipedia.org/wiki/Category\:Grammatical_gender
xref: https://en.wikipedia.org/wiki/Grammatical_gender
is_a: GSSO:002412 ! grammatical class
