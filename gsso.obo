[Term]
id: GSSO:007824
name: Early Christianity
def: "Christianity beginning with the ministry of Jesus (c. 27-30) and end with the First Council of Nicaea (325). It is typically divided into two periods: Christianity in the 1st century which is known as the Apostolic Age (c. 30–100, when the first apostles were still alive) and the Ante-Nicene Period (c. 100–325)." []
synonym: "Christianity, early" EXACT []
synonym: "early and medieval Christianity" BROAD [] {EXACT="Christianity, early and medieval", terms:isReferencedBy="https://www.worldcat.org/oclc/845370306"}
synonym: "early Christianity" EXACT []
xref: https://en.wikipedia.org/wiki/History_of_Christianity#Early_Christianity_(c._31/33%E2%80%93324)
is_a: GSSO:007367 ! Christianity
property_value: terms:isReferencedBy https://books.google.com/books?id=oSmBAAAAQBAJ

[Term]
id: GSSO:007825
name: Eastern Christianity
def: "Christian traditions and churches which developed in the Middle East, Egypt, Asia Minor, the Far East, Balkans, Eastern Europe, Northeastern Africa and southern India over several centuries of religious antiquity." []
xref: https://en.wikipedia.org/wiki/Category\:Eastern_Christianity
xref: https://en.wikipedia.org/wiki/Eastern_Christianity
