property_value: schema:alternateName "Polynesians" xsd:string

[Term]
id: GSSO:007723
name: Māori
def: "The Indigenous Polynesian people of New Zealand. Māori originated with settlers from eastern Polynesia, who arrived in New Zealand in several waves of waka (canoe) voyages somewhere between 1320 and 1350. Over several centuries in isolation, these settlers developed their own distinctive culture whose language, mythology, crafts and performing arts evolved independently from other eastern Polynesian cultures." []
synonym: "Maori" EXACT [] {schema:alternateName="Maoris"}
xref: https://en.wikipedia.org/wiki/Category\:M%C4%81ori
