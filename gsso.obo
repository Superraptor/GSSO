property_value: Property:P3095 "Black nationalist" xsd:string {schema:alternateName="Black nationalists"}

[Term]
id: GSSO:002268
name: white nationalism
def: "White nationalism is a type of nationalism or pan-nationalism that holds the belief that white people are a race and seeks to develop and maintain a white national identity." []
xref: https://en.wikipedia.org/wiki/White_nationalism
is_a: GSSO:002266 ! racial nationalism
