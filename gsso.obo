property_value: schema:alternateName "mixed sexual systems" xsd:string

[Term]
id: GSSO:011868
name: monoecy
def: "A sexual system in which male and female flowers are present on the same plant. It is common in angiosperms, and occurs in 10% of all plant species." []
synonym: "monoecious" RELATED []
xref: https://en.wikipedia.org/wiki/Monoecy
xref: https://www.wikidata.org/wiki/Q108131504
is_a: GSSO:011865 ! monomorphic sexual system

[Term]
id: GSSO:011869
name: gynomonoecy
def: "A sexual system in which the presence of both female and hermaphrodite flowers on the same individual of a plant species." []
synonym: "gynomonoecious" RELATED []
xref: https://en.wikipedia.org/wiki/Gynomonoecy
xref: https://www.wikidata.org/wiki/Q108146859
is_a: GSSO:011865 ! monomorphic sexual system

[Term]
id: GSSO:011870
name: andromonoecy
