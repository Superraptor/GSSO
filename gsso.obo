property_value: Property:P685 "http://purl.bioontology.org/ontology/NCBITAXON/121227" xsd:anyURI

[Term]
id: http://purl.bioontology.org/ontology/NCBITAXON/121228
name: crab louse
def: "An insect that is an obligate ectoparasite of humans, feeding exclusively on blood. The crab louse usually is found in the person's pubic hair. Although the louse cannot jump, it can also live in other areas of the body that are covered with coarse hair, such as the perianal area, in men practically the entire body, and in children the eyelashes." []
xref: https://en.wikipedia.org/wiki/Crab_louse
xref: https://www.wikidata.org/wiki/Q381271
is_a: http://purl.bioontology.org/ontology/NCBITAXON/121227
property_value: oboInOwl:hasSynonym "Pthirus pubis" xsd:string
