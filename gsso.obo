property_value: terms:isReferencedBy https://books.google.com/books/?id=ymkYAAAAIAAJ

[Term]
id: GSSO:004425
name: Oedipus complex
def: "Attachment of the child to the parent of the opposite sex, accompanied by envious and aggressive feelings toward the parent of the same sex." []
