property_value: schema:alternateName "determiners" xsd:string

[Term]
id: GSSO:002427
name: article
def: "A word that is used with a noun (as a standalone word or a prefix or suffix) to specify grammatical definiteness of the noun, and in some languages extending to volume or numerical scope." []
