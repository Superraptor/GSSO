property_value: schema:alternateName "blogospheres" xsd:string

[Term]
id: GSSO:010568
name: manosphere
def: "A collection of websites, blogs, and online forums promoting masculinity, strong opposition to feminism, and misogyny. Movements within the manosphere include the men's rights movement, incels (involuntary celibates), Men Going Their Own Way (MGTOW), pick-up artists (PUA), and fathers' rights groups." []
xref: https://en.wikipedia.org/wiki/Category\:Manosphere
