[Term]
id: GSSO:011001
name: matrifocal family
def: "A family unit consisting of a mother and her children." []
is_a: GSSO:003265 ! familie
property_value: schema:alternateName "matrifocal families" xsd:string

[Term]
id: GSSO:011002
name: patrifocal family
def: "A family unit consisting of a father and his children." []
