property_value: Property:P1813 "MMRate" xsd:string
property_value: schema:alternateName "maternal mortality rates" xsd:string

[Term]
id: GSSO:009643
name: stillbirth
def: "A fetus of at least 20 weeks gestation, or of a birth weight of at least 350 grams if the gestational age is unknown, that is born without signs of life at the time of delivery, and with an Apgar score of zero at both one and five minutes." []
def: "The event that a fetus is born dead or stillborn." []
