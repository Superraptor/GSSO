name: សក់​វែង
def: "A Khmer term describing a Cambodian person assigned male at person who identifies as female, occupies a more stereotypically feminine gender role, and who may use hormones or surgery to feminize their appearance." []
synonym: "GSSO:007857" RELATED []
is_a: GSSO:007854 ! kteuy
property_value: dc:identifier "http://homosaurus.org/v2/sakVeng" xsd:anyURI {terms:source="https://web.archive.org/web/20190828104105/http://homosaurus.org/v2"}
property_value: oboInOwl:hasSynonym "long hairs" xsd:string
property_value: terms:isReferencedBy https://books.google.com/books?id=hi8lDwAAQBAJ

[Term]
id: GSSO:007857
name: srey sros
name: ស្រីស្រស់
def: "A Khmer term describing a Cambodian person assigned male at person who identifies as female, occupies a more stereotypically feminine gender role, and who may use hormones or surgery to feminize their appearance." []
comment: "Srey sros" is usually translated literally as "beautiful lady" or "charming lady".
synonym: "GSSO:007856" RELATED []
