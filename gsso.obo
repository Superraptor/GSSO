property_value: schema:alternateName "Keresans" xsd:string

[Term]
id: GSSO:005496
name: Acoma Pueblo
def: "A Native American pueblo approximately 60 miles (97 km) west of Albuquerque, New Mexico in the United States. Four communities make up the village of Acoma Pueblo: Sky City (Old Acoma), Acomita, Anzac, and McCartys. The Acoma Pueblo tribe is a federally recognized tribal entity." []
xref: https://en.wikipedia.org/wiki/Acoma_Pueblo
xref: https://en.wikipedia.org/wiki/Category\:Acoma_Pueblo
