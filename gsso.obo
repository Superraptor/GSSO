name: autism spectrum disorder
def: "A spectrum of developmental disorders that includes autism, Asperger syndrome, and Rett syndrome. Signs and symptoms include poor communication skills, defective social interactions, and repetitive behaviors." []
def: "Wide continuum of associated cognitive and neurobehavioral disorders, including, but not limited to, three core-defining features: impairments in socialization, impairments in verbal and nonverbal communication, and restricted and repetitive patterns of behaviors." []
synonym: "autism or autism spectrum disorder" BROAD []
synonym: "autism spectrum disorder, unspecified" NARROW [] {schema:alternateName="autism spectrum disorders, unspecified"}
synonym: "GSSO:003110" BROAD []
synonym: "other specified autism spectrum disorder" NARROW [] {schema:alternateName="other specified autism spectrum disorders"}
