property_value: schema:alternateName "personlige pronominer" xsd:string {xref="https://lgbt.dk/ordbog/personlige-pronominer/"}

[Term]
id: GSSO:002407
name: possessive pronoun
def: "A pronoun which indicates a relationship of possession in a broad sense. This can include strict ownership, or a number of other types of relation to a greater or lesser degree analogous to it." []
