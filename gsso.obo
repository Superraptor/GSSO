property_value: oboInOwl:hasSynonym "religion in Ancient Greece" xsd:string
property_value: schema:alternateName "Ancient Greek religions" xsd:string

[Term]
id: GSSO:009683
name: Ancient Roman religion
def: "The ancestral ethnic religion of the city of Rome that the Romans used to define themselves as a people, as well as the religious practices of peoples brought under Roman rule, in so far as they became widely followed in Rome and Italy. The Romans thought of themselves as highly religious, and attributed their success as a world power to their collective piety (pietas) in maintaining good relations with the gods. The Romans are known for the great number of deities they honored, a capacity that earned the mockery of early Christian polemicists." []
xref: https://en.wikipedia.org/wiki/Category\:Ancient_Roman_religion
xref: https://en.wikipedia.org/wiki/Religion_in_ancient_Rome
xref: https://www.wikidata.org/wiki/Q337547
is_a: GSSO:009681 ! Classical religion
property_value: oboInOwl:hasSynonym "religion in Ancient Rome" xsd:string
property_value: schema:alternateName "Ancient Roman religions" xsd:string

