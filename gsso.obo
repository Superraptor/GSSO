property_value: Property:P5191 OBI:0400107
property_value: schema:alternateName "computer networks" xsd:string
property_value: wiki:Q1823134 "http://id.loc.gov/authorities/subjects/sh85029513" xsd:anyURI

[Term]
id: GSSO:000174
name: internet protocol
def: "The principal communications protocol in the internet protocol suite for relaying datagrams across network boundaries. Its routing function enables internetworking, and essentially establishes the internet." []
xref: https://en.wikipedia.org/wiki/Internet_Protocol
is_a: GSSO:000178 ! internet layer
property_value: Property:P1813 "IP" xsd:string
property_value: Property:P5191 NCIT:C20342

[Term]
id: GSSO:000175
name: internet protocol suite
def: "The conceptual model and set of communications protocols used in the Internet and similar computer networks." []
xref: https://en.wikipedia.org/wiki/Internet_protocol_suite
is_a: NCIT:C20342 ! internet

[Term]
id: GSSO:000176
name: application layer
def: "An abstraction layer that specifies the shared communications protocols and interface methods used by hosts in a communications network. The application layer abstraction is used in both of the standard models of computer networking: the Internet Protocol Suite (TCP/IP) and the OSI model." []
xref: https://en.wikipedia.org/wiki/Application_layer
is_a: GSSO:000175 ! internet protocol suite

[Term]
id: GSSO:000177
name: transport layer
def: "A conceptual division of methods in the layered architecture of protocols in the network stack in the Internet protocol suite and the OSI model. The protocols of this layer provide host-to-host communication services for applications." []
xref: https://en.wikipedia.org/wiki/Transport_layer
is_a: GSSO:000175 ! internet protocol suite

[Term]
id: GSSO:000178
name: internet layer
def: "A group of internetworking methods, protocols, and specifications in the Internet protocol suite that are used to transport network packets from the originating host across network boundaries, if necessary, to the destination host specified by an IP address." []
xref: https://en.wikipedia.org/wiki/Internet_layer
is_a: GSSO:000175 ! internet protocol suite
property_value: Property:P5191 NCIT:C20342

[Term]
id: GSSO:000179
name: Hypertext Transfer Protocol
def: "An application protocol for distributed, collaborative, hypermedia information systems. HTTP is the foundation of data communication for the World Wide Web, where hypertext documents include hyperlinks to other resources that the user can easily access, for example by a mouse click or by tapping the screen in a web browser." []
xref: https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol
is_a: GSSO:000176 ! application layer
property_value: Property:P1813 "HTTP" xsd:string
property_value: schema:dateCreated "1997" xsd:integer

[Term]
id: GSSO:000180
name: Network News Transfer Protocol
def: "An application protocol used for transporting Usenet news articles (netnews) between news servers and for reading and posting articles by end user client applications." []
xref: https://en.wikipedia.org/wiki/Network_News_Transfer_Protocol
is_a: GSSO:000176 ! application layer
property_value: Property:P1813 "NNTP" xsd:string
property_value: schema:dateCreated "March 1986" xsd:string

[Term]
id: GSSO:000181
name: Internet Relay Chat
def: "An application layer protocol that facilitates communication in the form of text. The chat process works on a client/server networking model. IRC clients are computer programs that users can install on their system or web based applications running either locally in the browser or on a third party server." []
xref: https://en.wikipedia.org/wiki/Internet_Relay_Chat
is_a: GSSO:000176 ! application layer
property_value: Property:P1813 "IRC" xsd:string
property_value: schema:dateCreated "August 1988" xsd:string

[Term]
id: GSSO:000182
name: Simple Mail Transfer Protocol
def: "A communication protocol for electronic mail transmission." []
xref: https://en.wikipedia.org/wiki/Simple_Mail_Transfer_Protocol
is_a: GSSO:000176 ! application layer
property_value: Property:P1813 "SMTP" xsd:string
property_value: schema:dateCreated "1982" xsd:integer

